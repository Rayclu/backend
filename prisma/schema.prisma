// Al que toque esto sin avisar, le corto los dedos
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db` a

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  NORMAL_USER
  ADMIN
  INSTITUTIONAL_USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  SUSPENDED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  INSTITUTION
  GROUP
}

enum EventCategory {
  CONFERENCE
  WORKSHOP
  MEETING
  SOCIAL
  SPORTS
  CULTURAL
  EDUCATIONAL
  NETWORKING
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  BLOCKED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ResourceType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  ARCHIVE
  SPREADSHEET
  PRESENTATION
  NOTE
  LOCATION
  LINK
  OTHER
}

model User {
  id                      String      @id @default(uuid())
  email                   String      @unique
  password                String
  firstName               String?
  lastName                String?
  avatar                  String?
  role                    UserRole    @default(NORMAL_USER)
  status                  UserStatus  @default(PENDING_VERIFICATION)
  phone                   String?
  twoFactorSecret         String?
  twoFactorEnabled        Boolean     @default(false)
  lastLoginAt             DateTime?
  refreshToken            String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  institutionId           String?
  institution             Institution? @relation("InstitutionUsers", fields: [institutionId], references: [id])

  createdEvents           Event[]     @relation("EventCreator")
  assignedEvents          Event[]     @relation("EventAssignee")
  ownedBoards             Board[]     @relation("BoardOwner")
  ownedInstitutions       Institution[] @relation("InstitutionOwner")
  ownedGroups             Group[]     @relation("GroupOwner")
  uploadedResources       Resource[]  @relation("ResourceUploader")
  assignedTasks           Task[]      @relation("TaskAssignee")
  createdTasks            Task[]      @relation("TaskCreator")
  attendedEvents          Event[]     @relation("EventAttendees")
  groups                  Group[]     @relation("GroupMembers")
  adminGroups             Group[]     @relation("GroupAdmins")
  pendingGroupRequests    Group[]     @relation("GroupPendingRequests")
  institutionAdmins       Institution[] @relation("InstitutionAdmins")
  comments                Comment[]
  messages                Message[]
  eventDateParticipants   EventDateData[] @relation("EventDateParticipants")
  boardMemberships        Board[]     @relation("BoardMembers")
  userPhoto               File?       @relation("UserPhoto")
}

model Institution {
  id          String   @id @default(uuid())
  name        String
  description String?
  logo        String?
  website     String?
  email       String?
  phone       String?
  address     String?
  city        String?
  country     String?
  timezone    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId     String
  owner       User     @relation("InstitutionOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  users       User[]   @relation("InstitutionUsers")
  events      Event[]
  boards      Board[]
  groups      Group[]
  admins      User[]   @relation("InstitutionAdmins")
}

model Board {
  id           String   @id @default(uuid())
  name         String
  description  String?
  color        String?
  icon         String?
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownerId      String
  owner        User     @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  institutionId String?
  institution  Institution? @relation(fields: [institutionId], references: [id])

  events       Event[]
  members      User[]   @relation("BoardMembers")
}

model Group {
  id                 String   @id @default(uuid())
  name               String
  description        String?
  avatar             String?
  coverImage         String?
  isPrivate          Boolean  @default(false)
  requiresApproval   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ownerId            String
  owner              User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  institutionId      String?
  institution        Institution? @relation(fields: [institutionId], references: [id])

  events             Event[]
  members            User[]   @relation("GroupMembers")
  admins             User[]   @relation("GroupAdmins")
  pendingRequests    User[]   @relation("GroupPendingRequests")
  messages           Message[]
  imageId            String?  @unique
  image              File?    @relation("GroupImage")
}

model Event {
  id                    String           @id @default(uuid())
  title                 String
  description           String?          @db.Text
  shortDescription      String?
  category              EventCategory    @default(OTHER)
  status                EventStatus      @default(DRAFT)
  visibility            EventVisibility  @default(PUBLIC)
  startDate             DateTime         @db.Timestamptz(6)
  endDate               DateTime         @db.Timestamptz(6)
  timezone              String?
  location              String?
  address               String?
  city                  String?
  country               String?
  latitude              Decimal?         @db.Decimal(10, 8)
  longitude             Decimal?         @db.Decimal(11, 8)
  venueName             String?
  venueCapacity         Int?
  coverImage            String?
  bannerImage           String?
  tags                  String[]
  website               String?
  registrationUrl       String?
  maxAttendees          Int              @default(0)
  currentAttendees      Int              @default(0)
  requiresRegistration  Boolean          @default(false)
  isFree                Boolean          @default(false)
  price                 Decimal?         @db.Decimal(10, 2)
  currency              String?
  contactEmail          String?
  contactPhone          String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  publishedAt           DateTime?
  cancelledAt           DateTime?
  cancellationReason    String?

  creatorId             String
  creator               User             @relation("EventCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  assigneeId            String?
  assignee              User?            @relation("EventAssignee", fields: [assigneeId], references: [id])

  boardId               String?
  board                 Board?           @relation(fields: [boardId], references: [id])

  institutionId         String?
  institution           Institution?     @relation(fields: [institutionId], references: [id])

  groupId               String?
  group                 Group?           @relation(fields: [groupId], references: [id])

  resources             Resource[]
  tasks                 Task[]
  attendees             User[]           @relation("EventAttendees")
  eventDates            EventDateData[]  @relation("EventDateData")
  pendingEventDates     EventDate[]      @relation("PendingEventDate")
  files                 File[]
}

model EventDateData {
  id                String        @id @default(uuid())
  maxParticipants   Int
  initAt            DateTime      @db.Timestamptz(6)
  endsAt            DateTime      @db.Timestamptz(6)

  eventId           String
  event             Event         @relation("EventDateData", fields: [eventId], references: [id])

  locationId        Int
  location          Location      @relation("EventDateLocation", fields: [locationId], references: [id])

  participants      User[]        @relation("EventDateParticipants")
  review            Int[]         // Ref Comment
}

model EventDate {
  id        String   @id @default(uuid())
  initAt    DateTime @db.Timestamptz(6)
  endsAt    DateTime @db.Timestamptz(6)

  eventId   String
  event     Event    @relation("PendingEventDate", fields: [eventId], references: [id])
}

model Location {
  id           Int             @id @default(autoincrement())
  name         String
  direction    String
  y            Float
  x            Float
  review       Int[]           // Ref Comment
  eventDates   EventDateData[] @relation("EventDateLocation")
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?      @db.Text
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?    @db.Timestamptz(6)
  startDate     DateTime?    @db.Timestamptz(6)
  completedAt   DateTime?    @db.Timestamptz(6)
  estimatedHours Float?
  actualHours   Float?
  tags          String[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assigneeId    String
  assignee      User         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  creatorId     String
  creator       User         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  eventId       String?
  event         Event?       @relation(fields: [eventId], references: [id])

  boardId       String?
}

model Resource {
  id           String        @id @default(uuid())
  title        String
  description  String?       @db.Text
  type         ResourceType  @default(DOCUMENT)
  fileName     String
  fileUrl      String
  mimeType     String?
  fileSize     Int?
  thumbnailUrl String?
  tags         String[]
  isPublic     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  uploaderId   String
  uploader     User          @relation("ResourceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  eventId      String?
  event        Event?        @relation(fields: [eventId], references: [id])

  boardId      String?
  institutionId String?
  groupId      String?
}

model Comment {
  id        Int      @id @default(autoincrement())
  message   String
  review    Int
  senderId  String
  sender    User?    @relation(fields: [senderId], references: [id])
  createdAt DateTime @default(now())
}

model Message {
  id        String   @id @default(uuid())
  groupId   String
  content   String
  senderId  String
  reactions String[]
  createdAt DateTime @default(now())

  group     Group?   @relation(fields: [groupId], references: [id])
  sender    User?    @relation(fields: [senderId], references: [id])
}

model File {
  id           String   @id @default(uuid())
  name         String
  type         String?
  size         Int?
  content      Bytes
  uploaded     DateTime @default(now()) @db.Timestamptz(6)

  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])

  userId       String?  @unique
  user         User?    @relation("UserPhoto", fields: [userId], references: [id])

  groupId      String?  @unique
  group        Group?   @relation("GroupImage", fields: [groupId], references: [id])

  reports      Report[] @relation("ReportProofs")
}

model Report {
  id        String   @id @default(uuid())
  reported  Int
  type      ReportType
  reason    Reason
  proof     File[]   @relation("ReportProofs")
  comment   String
  date      DateTime @default(now())
}

enum ReportType {
  MENSAJE
  VALORACION
  USUARIO
  EVENTO
  UBICACION
  GRUPO
}

enum Reason {
  CONTENIDO_INDEVIDO
}